# ==============================================================================
# Git Ignore Configuration for godocs (Go Backend + Static Web Dashboard)
# ==============================================================================

# 1. Compiled Binaries & Build Artifacts (prefixed with / to match repository root)
/bin/
/out/
/api
/godocs
*.exe
*.exe~
*.dll
*.so
*.dylib

# 2. Test Executables & Runtime Profiling Outputs
*.test
*.prof
*.pprof

# 3. Local Runtime State (SQLite databases, file uploads & application logs) — NEVER commit
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
/uploads/
/log/
/logs/
*.log

# 4. Environment Configurations & Sensitive Secrets
.env
.env.*
!.env.example

# 5. Code Coverage Metrics & Automated Test Reports
*.out
coverage.html
coverage.txt
*.cov

# 6. IDEs, Text Editors, and AI Agent Workspaces
.idea/
.vscode/
*.swp
*.swo
*~
.claude/
.gemini/

# 7. Operating System Artifacts (macOS, Windows, Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
